# ===== Mercado Pago =====
# Access Token de PRODUCCIÓN (empieza con APP_USR-...). Para pruebas podés usar el de prueba.
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxxxxxx
# Clave secreta de webhooks (Tus integraciones > Webhooks > Clave secreta)
MP_WEBHOOK_SECRET=pegá_acá_la_clave_secreta
# Precio inicial del crédito en ARS (solo se usa la primera vez; después se cambia desde la app)
DEFAULT_PRICE=2000
ITEM_TITLE=1 crédito Arcade

# ===== Servidor =====
HOST=0.0.0.0
PORT=8000

# ===== Créditos =====
# Tecla de moneda común configurada en TODOS los emuladores
CREDIT_KEY=5
# Cuánto tiempo se mantiene apretada la tecla (segundos) y pausa entre pulsaciones
KEY_PRESS_DURATION=0.08
KEY_PRESS_DELAY=0.25
# 1 = intentar traer al frente la ventana del emulador antes de apretar
FOCUS_EMULATOR=1

# ===== Admin (app Android en el WiFi local) =====
ADMIN_KEY=cambiá_esta_clave_larga_y_secreta

# ===== GitHub Pages (redirección del QR) =====
# Token fine-grained con permiso "Contents: Read and write" SOLO sobre el repo de la página
GITHUB_TOKEN=github_pat_xxxxxxxx
# usuario/repositorio de la página fija del QR (cuenta del cliente)
GITHUB_PAGES_REPO=frarcade-26/frarcade-26.github.io
GITHUB_PAGES_BRANCH=main
# URL que va impresa en el QR del gabinete. NO la cambies salvo que cambies de página.
QR_URL=https://frarcade-26.github.io/

# ===== Cloudflare =====
# Ruta a cloudflared.exe (si está en la carpeta del proyecto, dejalo así)
CLOUDFLARED_PATH=cloudflared.exe
# Si usás túnel con nombre (URL fija), poné la URL acá y el launcher no arranca túnel temporal
PUBLIC_URL=

# ===== Archivos =====
DB_PATH=data/arcade.db
LOG_DIR=logs
